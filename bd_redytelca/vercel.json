{
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.6.0"
    }
  },
  "routes": [
    {
      "src": "^/(.*\\.php)$",
      "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "dest": "/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(cliente|portal|pagos|pago)(?:/.*)?$",
      "dest": "/portal_cliente.php"
    },
    {
      "src": "^/admin(?:/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "/$1"
    }
  ]
}